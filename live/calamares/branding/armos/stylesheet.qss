/* ARMOS 1.0 "GEN" — Calamares theme.
 * Neutral graphite surfaces, hairline borders, 6px radii, restrained blue accent. */

QWidget {
    background-color: #1B1B1B;
    color: #E6E6E6;
    font-family: "Noto Sans";
    font-size: 10pt;
}

QDialog, QMainWindow {
    background-color: #1B1B1B;
}

/* ---- Buttons ---------------------------------------------------------- */

QPushButton {
    background-color: #2D2D2D;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 7px 18px;
    min-height: 20px;
    color: #E6E6E6;
}

QPushButton:hover {
    background-color: #363636;
    border-color: #4A4A4A;
}

QPushButton:pressed {
    background-color: #262626;
}

QPushButton:default,
QPushButton:focus {
    background-color: #4C8DFF;
    border-color: #4C8DFF;
    color: #FFFFFF;
}

QPushButton:default:hover {
    background-color: #5E9AFF;
    border-color: #5E9AFF;
}

QPushButton:disabled {
    color: #7A7A7A;
    border-color: #2F2F2F;
    background-color: #232323;
}

/* ---- Text inputs ------------------------------------------------------ */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #242424;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 5px 8px;
    color: #E6E6E6;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #4C8DFF;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #242424;
    border: 1px solid #3A3A3A;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

/* ---- Progress and sliders -------------------------------------------- */

QProgressBar {
    background-color: #242424;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #4C8DFF;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #3A3A3A;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #4C8DFF;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #E6E6E6;
    border: 1px solid #4A4A4A;
    width: 14px;
    margin: -6px 0;
    border-radius: 8px;
}

/* ---- Lists and tables ------------------------------------------------- */

QListView, QTreeView, QTableView {
    background-color: #242424;
    alternate-background-color: #292929;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    selection-background-color: #4C8DFF;
    selection-color: #FFFFFF;
}

QListView::item, QTreeView::item {
    padding: 5px;
}

QHeaderView::section {
    background-color: #2A2A2A;
    color: #D8D8D8;
    border: none;
    border-bottom: 1px solid #3A3A3A;
    padding: 6px;
}

/* ---- Tabs and checkboxes --------------------------------------------- */

QTabBar::tab {
    background-color: #242424;
    color: #B0B0B0;
    border: 1px solid #3A3A3A;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 14px;
}

QTabBar::tab:selected {
    background-color: #1B1B1B;
    color: #E6E6E6;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #4C8DFF;
    border: 2px solid #4C8DFF;
}

QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    background-color: #242424;
    border: 2px solid #3A3A3A;
}

/* ---- Scrollbars and tooltips ----------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3F3F3F;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    height: 0;
}

QToolTip {
    background-color: #2A2A2A;
    color: #E6E6E6;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ---- Calamares-specific ---------------------------------------------- */

#sidebarApp, #sidebar {
    background-color: #1B1B1B;
    border: none;
}

#logoApp {
    padding: 8px;
}
