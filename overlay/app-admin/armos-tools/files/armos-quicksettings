#!/usr/bin/env python3
"""ARMOS Quick Settings — Wi-Fi, Bluetooth, sound, brightness and shortcuts."""

import glob
import os
import sys

sys.path.insert(0, "/usr/lib/armos")

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk  # noqa: E402

import armos_common as common  # noqa: E402


def run(argv, stdin=None):
    """Run a helper, returning stdout only (errors are reported by checked())."""
    return common.run(argv, stdin)[0]


def backlight():
    """Return (path, max, current) for the first usable sysfs backlight."""
    for base in sorted(glob.glob("/sys/class/backlight/*")):
        cur_path = os.path.join(base, "brightness")
        max_path = os.path.join(base, "max_brightness")
        try:
            with open(cur_path, "r", encoding="ascii") as fh:
                current = int(fh.read().strip())
            with open(max_path, "r", encoding="ascii") as fh:
                maximum = int(fh.read().strip())
        except (OSError, ValueError):
            continue
        if maximum > 0:
            return cur_path, maximum, current
    return None


def output_name():
    text = run(["xrandr", "--query"])
    for line in text.splitlines():
        if " connected" in line:
            return line.split()[0]
    return ""


class QuickSettings(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.armos.QuickSettings")

    def do_activate(self):
        common.apply_theme()
        window = Gtk.ApplicationWindow(application=self, title="Быстрые настройки")
        window.set_default_size(360, 440)
        window.set_position(Gtk.WindowPosition.MOUSE)
        window.set_resizable(False)

        def checked(argv, what, stdin=None):
            out, err = common.run(argv, stdin)
            if err:
                common.message(window, "{}: {}".format(what, err), Gtk.MessageType.WARNING)
            return out

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        outer.set_border_width(20)
        window.add(outer)

        title = Gtk.Label(label="Быстрые настройки", xalign=0)
        title.get_style_context().add_class("title")
        outer.pack_start(title, False, False, 0)

        def switch_row(name, initial, callback):
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            label = Gtk.Label(label=name, xalign=0)
            label.get_style_context().add_class("tile-title")
            toggle = Gtk.Switch()
            toggle.set_active(initial)
            toggle.set_halign(Gtk.Align.END)
            toggle.connect("notify::active", callback)
            box.pack_start(label, True, True, 0)
            box.pack_start(toggle, False, False, 0)
            button = Gtk.Button()
            button.get_style_context().add_class("tile")
            button.add(box)
            outer.pack_start(button, False, False, 0)
            return toggle

        # Wi-Fi
        wifi_state = run(["nmcli", "radio", "wifi"]) == "enabled"

        def wifi_toggle(toggle, *_):
            checked(
                ["nmcli", "radio", "wifi", "on" if toggle.get_active() else "off"],
                "Wi-Fi",
            )

        switch_row("Wi-Fi", wifi_state, wifi_toggle)

        # Bluetooth
        bt_text = run(["bluetoothctl"], stdin="show\nquit\n")
        bt_state = "Powered: yes" in bt_text

        def bluetooth_toggle(toggle, *_):
            checked(
                ["bluetoothctl"],
                "Bluetooth",
                stdin="power {}\nquit\n".format("on" if toggle.get_active() else "off"),
            )

        switch_row("Bluetooth", bt_state, bluetooth_toggle)

        # Airplane mode
        airplane = run(["nmcli", "networking"]) == "disabled"

        def airplane_toggle(toggle, *_):
            checked(
                ["nmcli", "networking", "off" if toggle.get_active() else "on"],
                "Авиарежим",
            )

        switch_row("Авиарежим", airplane, airplane_toggle)

        # Sound mute
        muted = "yes" in run(["pactl", "get-sink-mute", "@DEFAULT_SINK@"])

        def mute_toggle(toggle, *_):
            checked(
                ["pactl", "set-sink-mute", "@DEFAULT_SINK@", "1" if toggle.get_active() else "0"],
                "Звук",
            )

        switch_row("Звук выключен", muted, mute_toggle)

        # Brightness: real backlight slider when the hardware exposes one,
        # otherwise fall back to xrandr gamma.
        back = backlight()
        if back:
            path, maximum, current = back
            dim_label = Gtk.Label(label="Яркость экрана", xalign=0)
            dim_label.get_style_context().add_class("tile-title")
            dim_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            dim_box.get_style_context().add_class("tile")
            dim_box.pack_start(dim_label, False, False, 0)
            adjustment = Gtk.Adjustment(
                value=current, lower=0, upper=maximum, step_increment=max(1, maximum // 20)
            )
            slider = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adjustment)
            slider.set_digits(0)
            slider.set_hexpand(True)

            def write_backlight(_scale, value):
                value = str(int(value))
                if os.access(path, os.W_OK):
                    try:
                        with open(path, "w", encoding="ascii") as fh:
                            fh.write(value)
                        return
                    except OSError:
                        pass
                checked(
                    ["pkexec", "sh", "-c", "printf '{}' > {}".format(value, path)],
                    "Яркость",
                )

            # Write only after the user releases the slider, not on every step.
            slider.connect(
                "button-release-event",
                lambda widget, _event: write_backlight(widget, widget.get_value()),
            )
            slider.connect(
                "key-release-event",
                lambda widget, _event: write_backlight(widget, widget.get_value()),
            )
            dim_box.pack_start(slider, False, False, 0)
            outer.pack_start(dim_box, False, False, 0)
        else:
            dim_label = Gtk.Label(label="Яркость: нормальная", xalign=0)
            dim_label.get_style_context().add_class("tile-title")
            dim_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            dim_box.pack_start(dim_label, True, True, 0)
            dim_button = Gtk.Button(label="50%")
            dim_button.get_style_context().add_class("tile")

            def dim(_button):
                output = output_name()
                if output and dim_button.get_label() == "50%":
                    checked(
                        ["xrandr", "--output", output, "--brightness", "0.5"], "Яркость"
                    )
                    dim_button.set_label("норма")
                    dim_label.set_text("Яркость: снижена")
                elif output:
                    checked(
                        ["xrandr", "--output", output, "--brightness", "1.0"], "Яркость"
                    )
                    dim_button.set_label("50%")
                    dim_label.set_text("Яркость: нормальная")
                else:
                    dim_button.set_label("нет вывода")

            dim_button.connect("clicked", dim)
            dim_box.pack_start(dim_button, False, False, 0)
            outer.pack_start(dim_box, False, False, 0)

        outer.pack_start(Gtk.Separator(), False, False, 4)

        def action(label, icon, argv):
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
            text = Gtk.Label(label=label, xalign=0)
            text.get_style_context().add_class("tile-title")
            box.pack_start(image, False, False, 0)
            box.pack_start(text, False, False, 0)
            button = Gtk.Button()
            button.get_style_context().add_class("tile")
            button.add(box)
            button.connect("clicked", lambda *_: common.launch(argv))
            outer.pack_start(button, False, False, 0)

        action("Сети", "network-workgroup", ["nm-connection-editor"])
        action("Звук", "audio-volume-high", ["pavucontrol"])
        action("Оформление ARMOS", "preferences-desktop-theme", ["armos-settings"])
        action("Снимок экрана", "applets-screenshooter", ["xfce4-screenshooter"])

        window.show_all()


if __name__ == "__main__":
    sys.exit(QuickSettings().run(sys.argv))
