#!/usr/bin/env python3
"""ARMOS First Run — short setup wizard shown once per user."""

import os
import sys

sys.path.insert(0, "/usr/lib/armos")

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk  # noqa: E402

import armos_common as common  # noqa: E402

LAYOUTS = [
    ("Русский (us,ru)", "us,ru", "grp:alt_shift_toggle"),
    ("English (us)", "us", ""),
]
ZONES = [
    ("Москва", "Europe/Moscow"),
    ("Киев", "Europe/Kyiv"),
    ("Екатеринбург", "Asia/Yekaterinburg"),
    ("UTC", "UTC"),
]


class FirstRun(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.armos.FirstRun")

    def do_activate(self):
        marker_dir = os.path.expanduser("~/.config/armos")
        marker = os.path.join(marker_dir, "first-run-done")
        if os.path.exists(marker) and not common.is_live():
            self.quit()
            return

        common.apply_theme()
        assistant = Gtk.Assistant()
        assistant.set_default_size(620, 460)
        assistant.set_position(Gtk.WindowPosition.CENTER)
        assistant.connect("destroy", self._on_destroy)
        self._assistant = assistant

        # Page 1 — language and keyboard layout.
        page1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page1.set_border_width(24)
        label = Gtk.Label(label="Добро пожаловать в ARMOS 1.0 «GEN»", xalign=0)
        label.get_style_context().add_class("title")
        label.set_line_wrap(True)
        page1.pack_start(label, False, False, 0)
        desc = Gtk.Label(
            label="Выберите раскладку клавиатуры. Её можно изменить позже "
                  "в Центре ARMOS.",
            xalign=0,
        )
        desc.set_line_wrap(True)
        desc.get_style_context().add_class("subtitle")
        page1.pack_start(desc, False, False, 0)
        self.layout = Gtk.ComboBoxText()
        for name, _layout, _options in LAYOUTS:
            self.layout.append_text(name)
        self.layout.set_active(0)
        page1.pack_start(self.layout, False, False, 0)
        assistant.append_page(page1)
        assistant.set_page_title(page1, "Язык и клавиатура")
        assistant.set_page_type(page1, Gtk.AssistantPageType.INTRO)
        assistant.set_page_complete(page1, True)

        # Page 2 — timezone.
        page2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page2.set_border_width(24)
        label = Gtk.Label(label="Часовой пояс", xalign=0)
        label.get_style_context().add_class("title")
        page2.pack_start(label, False, False, 0)
        self.zone = Gtk.ComboBoxText()
        for name, _zone in ZONES:
            self.zone.append_text(name)
        self.zone.set_active(0)
        page2.pack_start(self.zone, False, False, 0)
        assistant.append_page(page2)
        assistant.set_page_title(page2, "Время")
        assistant.set_page_type(page2, Gtk.AssistantPageType.CONTENT)
        assistant.set_page_complete(page2, True)

        # Page 3 — final actions.
        page3 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page3.set_border_width(24)
        label = Gtk.Label(label="Всё готово", xalign=0)
        label.get_style_context().add_class("title")
        page3.pack_start(label, False, False, 0)
        desc = Gtk.Label(
            label="Вы можете установить ARMOS на диск или сразу перейти "
                  "к рабочему столу.",
            xalign=0,
        )
        desc.set_line_wrap(True)
        desc.get_style_context().add_class("subtitle")
        page3.pack_start(desc, False, False, 0)
        install = Gtk.Button(label="Установить ARMOS")
        install.get_style_context().add_class("suggested")
        install.connect("clicked", self._install)
        page3.pack_start(install, False, False, 0)
        center = Gtk.Button(label="Открыть Центр ARMOS")
        center.connect("clicked", lambda *_: common.launch(["armos-center"]))
        page3.pack_start(center, False, False, 0)
        assistant.append_page(page3)
        assistant.set_page_title(page3, "Завершение")
        assistant.set_page_type(page3, Gtk.AssistantPageType.CONFIRM)
        assistant.set_page_complete(page3, True)

        assistant.connect("apply", self._apply)
        assistant.connect("cancel", lambda *_: assistant.destroy())
        assistant.connect("close", lambda *_: assistant.destroy())
        assistant.show_all()

    def _apply(self, *_):
        index = self.layout.get_active()
        if 0 <= index < len(LAYOUTS):
            _name, layout, options = LAYOUTS[index]
            common.xfconf_set("keyboard-layout", "/Default/XkbLayout", layout)
            common.xfconf_set("keyboard-layout", "/Default/XkbVariant", "," if layout == "us,ru" else "")
            common.xfconf_set("keyboard-layout", "/Default/XkbOptions", options)
            common.xfconf_set("keyboard-layout", "/Default/XkbDisable", "false", "bool")

        index = self.zone.get_active()
        if 0 <= index < len(ZONES):
            _name, zone = ZONES[index]
            try:
                os.makedirs(os.path.expanduser("~/.config/armos"), exist_ok=True)
                with open(os.path.expanduser("~/.config/armos/timezone"), "w") as fh:
                    fh.write(zone + "\n")
                profile = os.path.expanduser("~/.bash_profile")
                with open(profile, "a") as fh:
                    fh.write("\nexport TZ='{}'\n".format(zone))
            except OSError:
                pass
        self._assistant.destroy()

    def _install(self, *_):
        if not common.launch(["calamares"]):
            common.message(
                self._assistant,
                "Установщик Calamares не найден.",
                Gtk.MessageType.ERROR,
            )

    def _on_destroy(self, *_):
        try:
            os.makedirs(os.path.expanduser("~/.config/armos"), exist_ok=True)
            open(os.path.expanduser("~/.config/armos/first-run-done"), "w").close()
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(FirstRun().run(sys.argv))
