#!/usr/bin/env python3
"""ARMOS Center — a small hub for system settings and ARMOS tools."""

import sys

sys.path.insert(0, "/usr/lib/armos")

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk  # noqa: E402

import armos_common as common  # noqa: E402


def about(window):
    dialog = Gtk.AboutDialog(transient_for=window, modal=True)
    dialog.set_program_name("ARMOS")
    dialog.set_version("1.0 «GEN»")
    dialog.set_comments(
        "Source-based Linux на базе Gentoo.\n"
        "XFCE, OpenRC, Portage и фирменные приложения ARMOS."
    )
    dialog.set_website("https://armos.local/")
    dialog.set_license_type(Gtk.License.GPL_3_0)
    logo = common.logo_path()
    if logo:
        from gi.repository import GdkPixbuf

        try:
            dialog.set_logo(GdkPixbuf.Pixbuf.new_from_file(logo))
        except Exception:
            pass
    dialog.run()
    dialog.destroy()


def tile(window, title, subtitle, icon, callback):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
    image.set_halign(Gtk.Align.START)
    box.pack_start(image, False, False, 0)
    label = Gtk.Label(label=title, xalign=0)
    label.get_style_context().add_class("tile-title")
    box.pack_start(label, False, False, 0)
    sub = Gtk.Label(label=subtitle, xalign=0)
    sub.set_line_wrap(True)
    sub.get_style_context().add_class("tile-subtitle")
    box.pack_start(sub, False, False, 0)

    button = Gtk.Button()
    button.get_style_context().add_class("tile")
    button.add(box)
    button.connect("clicked", lambda *_: callback())
    return button


class Center(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.armos.Center")

    def do_activate(self):
        common.apply_theme()
        window = Gtk.ApplicationWindow(application=self, title="Центр ARMOS")
        window.set_default_size(820, 620)
        window.set_position(Gtk.WindowPosition.CENTER)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        outer.set_border_width(24)
        window.add(outer)

        title = Gtk.Label(label="Центр ARMOS", xalign=0)
        title.get_style_context().add_class("title")
        outer.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(
            label="Обновления, приложения, оборудование и параметры рабочего стола.",
            xalign=0,
        )
        subtitle.get_style_context().add_class("subtitle")
        outer.pack_start(subtitle, False, False, 0)

        grid = Gtk.Grid(column_spacing=12, row_spacing=12)
        grid.set_column_homogeneous(True)
        grid.set_row_homogeneous(True)
        outer.pack_start(grid, True, True, 0)

        def run(argv):
            def callback():
                if not common.launch(argv):
                    common.message(
                        window,
                        "Не удалось запустить «{}».\n"
                        "Проверьте, установлен ли соответствующий пакет.".format(argv[0]),
                        Gtk.MessageType.WARNING,
                    )

            return callback

        tiles = [
            (
                "Обновления",
                "Синхронизация репозиториев и обновление системы",
                "system-software-update",
                run(["armos-updater"]),
            ),
            (
                "Приложения",
                "Каталог программ и установка пакетов",
                "system-software-install",
                run(["armos-store"]),
            ),
            (
                "Внешний вид",
                "Темы, значки, шрифты и обои",
                "preferences-desktop-theme",
                run(["xfce4-appearance-settings"]),
            ),
            (
                "Параметры XFCE",
                "Все настройки рабочего стола",
                "preferences-system",
                run(["xfce4-settings-manager"]),
            ),
            (
                "Сеть",
                "Подключения Ethernet и Wi-Fi",
                "network-workgroup",
                run(["nm-connection-editor"]),
            ),
            (
                "Звук",
                "Устройства вывода и громкость",
                "audio-volume-high",
                run(["pavucontrol"]),
            ),
            (
                "Клавиатура",
                "Раскладка, сочетания клавиш, мышь",
                "input-keyboard",
                run(["xfce4-keyboard-settings"]),
            ),
            (
                "О системе",
                "Версия, лицензия и сведения о сборке",
                "help-about",
                lambda: about(window),
            ),
        ]

        for index, (name, desc, icon, callback) in enumerate(tiles):
            grid.attach(tile(window, name, desc, icon, callback), index % 3, index // 3, 1, 1)

        window.show_all()


if __name__ == "__main__":
    sys.exit(Center().run(sys.argv))
