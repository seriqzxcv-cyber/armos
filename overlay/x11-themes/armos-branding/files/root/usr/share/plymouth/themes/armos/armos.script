# ARMOS 1.0 GEN — Plymouth boot splash.
# Restrained graphite background, ARMOS logo, thin accent progress bar.

wallpaper_image = Image("background.png");
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
wallpaper_sprite = Sprite(wallpaper_image.Scale(screen_width, screen_height));
wallpaper_sprite.SetZ(-100);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(screen_width / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(screen_height / 2 - logo_image.GetHeight() / 2 - 32);
logo_sprite.SetZ(10);

bar_width = 420;
bar_height = 6;
bar_x = screen_width / 2 - bar_width / 2;
bar_y = screen_height / 2 + logo_image.GetHeight() / 2 + 24;

bar_bg = Image("bar-bg.png");
bar_bg_sprite = Sprite(bar_bg);
bar_bg_sprite.SetX(bar_x);
bar_bg_sprite.SetY(bar_y);
bar_bg_sprite.SetZ(5);

bar_fg = Image("bar-fg.png");
progress_sprite = Sprite(bar_fg.Scale(1, bar_height));
progress_sprite.SetX(bar_x);
progress_sprite.SetY(bar_y);
progress_sprite.SetZ(6);

message = Text("Загрузка ARMOS...");
message.SetFont("Noto Sans", 14);
message.SetColor(0.90, 0.92, 0.95, 1.0);
message.SetX(screen_width / 2 - 120);
message.SetY(bar_y + 18);
message.SetZ(10);

fun armos_progress(value) {
    width = value * bar_width;
    if (width < 1)
        width = 1;
    progress_sprite.SetImage(bar_fg.Scale(width, bar_height));
}

fun armos_message(text) {
    message.SetText(text);
}

Plymouth.SetBootProgressFunction(armos_progress);
Plymouth.SetMessageFunction(armos_message);
